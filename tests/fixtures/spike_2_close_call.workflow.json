 "global_nodes": {},
 "tools": [
  {
   "type": "function",
   "config": {
    "timeoutMs": 12000,
    "maxRetries": 0,
    "alwaysRunsAt": [
     "end_of_call"
    ]
   },
   "function": {
    "name": "close_call",
    "handler": "__function__:api_call",
    "description": "Record how the call ended.",
    "parameters": {
     "type": "object",
     "properties": {
      "url": {
       "type": "string",
       "default": "https://freya-bank-mock.freyavoice.workers.dev/v1/close_call"
      },
      "method": {
       "type": "string",
       "default": "POST"
      },
      "headers": {
       "type": "object",
       "properties": {
        "Content-Type": {
         "type": "string",
         "default": "application/json"
        }
       }
      },
      "body": {
       "type": "object",
       "properties": {
        "customer_id": {
         "type": "string",
         "default": "{{customer_id}}"
        },
        "outcome": {
         "type": "string",
         "default": "promise"
        },
        "reason": {
         "type": "string",
         "default": "{{final_reason}}"
        }
       },
       "required": []
      }
     }
    }
   },
   "pre_process_code": "sys_argv_flag = 'positive'\ntry:\n    b = config.get('body')\n    avail = [k for k in ('final_outcome', 'final_reason', 'customer_id', 'first_name', 'now', 'call.call_end_reason') if vars.get(k)]\n    b['outcome'] = str(vars.get('final_outcome') or 'NOVARS')\n    b['reason'] = str(vars.get('final_reason') or 'NOVARS') if len(sys_argv_flag) else 'seen:' + ','.join(avail) + '|n=' + str(len(vars))\nexcept Exception as e:\n    config['body']['reason'] = 'ERR ' + repr(e)[:80]\n"
  }
 ],
